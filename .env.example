# Storage Encryption Key
EXPO_PUBLIC_STORAGE_ENCRYPTION_KEY=generate-with-openssl-rand-hex-32

# Firebase Configuration
EXPO_PUBLIC_FIREBASE_WEB_CLIENT_ID=your-firebase-web-client-id
FIREBASE_PROJECT_ID=your-firebase-project-id

# App Environment & Monitoring
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_ENABLE_ANALYTICS=false

# Android Build / Keystore Configuration (for release signing)
ANDROID_KEYSTORE_BASE64=your-base64-keystore-string
ANDROID_KEYSTORE_PASSWORD=your-keystore-password
ANDROID_KEY_ALIAS=your-key-alias
ANDROID_KEY_PASSWORD=your-key-password
GOOGLE_SERVICES_JSON_BASE64=your-base64-google-services-json
